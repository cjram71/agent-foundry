  fromEntityId     String
  fromEntity       WorldEntity @relation("WorldRelationFrom", fields: [fromEntityId], references: [id], onDelete: Restrict)
  toEntityId       String
  toEntity         WorldEntity @relation("WorldRelationTo", fields: [toEntityId], references: [id], onDelete: Restrict)
  relationType     String
  attributes       Json
  sourceReference  String
  confidence       Float       @default(0)
  validationStatus String      @default("PROPOSED")
  createdBy        String
  createdAt        DateTime    @default(now())
  evidence         KnowledgeEvidence[]

  @@unique([companyId, fromEntityId, toEntityId, relationType])
  @@index([companyId, relationType])
}

/// Provenance-first knowledge graph: approved source documents. Extraction
/// and resolution write proposed WorldEntity/WorldRelation rows plus
/// KnowledgeEvidence citing back to a document; see
/// docs/CRM_KNOWLEDGE_GRAPH_ROADMAP.md.
model KnowledgeDocument {
  id               String                   @id @default(uuid())
  companyId        String
  company          Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  namespace        String
  title            String
  sourceUri        String
  contentHash      String
  classification   String                   @default("INTERNAL")
  ingestionStatus  String                   @default("PENDING_APPROVAL")
  approvedBy       String?
  approvedAt       DateTime?
  createdBy        String
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  extractionRuns   KnowledgeExtractionRun[]
  evidence         KnowledgeEvidence[]

  @@unique([companyId, contentHash])
  @@index([companyId, namespace, ingestionStatus])
}

model KnowledgeExtractionRun {
  id                  String              @id @default(uuid())
  companyId           String
  company             Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  documentId          String
  document            KnowledgeDocument   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  model               String
  promptVersion       String
  schemaVersion       String
  tokenLimit          Int?
  costLimitMinor      BigInt?
  status              String              @default("PENDING")
  outcome             Json?
  proposedEntityCount Int                 @default(0)
  proposedEdgeCount   Int                 @default(0)
  errorMessage        String?
  createdBy           String
  createdAt           DateTime            @default(now())
  completedAt         DateTime?
  aliases             KnowledgeAlias[]
  evidence            KnowledgeEvidence[]

  @@index([companyId, documentId, createdAt])
  @@index([companyId, status])
}

/// Surface forms proposed by an extraction run. entityId stays null for an
/// unresolved/unmatched name so it is never silently dropped.
model KnowledgeAlias {
  id                String                  @id @default(uuid())
  companyId         String
  company           Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  surfaceForm       String
  entityId          String?
  entity            WorldEntity?            @relation(fields: [entityId], references: [id], onDelete: SetNull)
  extractionRunId   String?
  extractionRun     KnowledgeExtractionRun? @relation(fields: [extractionRunId], references: [id], onDelete: SetNull)
  resolutionStatus  String                  @default("PROPOSED")
  confidence        Float                   @default(0)
  createdBy         String
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@index([companyId, resolutionStatus])
  @@index([entityId])
}

/// Provenance for one proposed WorldEntity or WorldRelation assertion.
/// Exactly one of entityId/relationId is set (enforced in migration SQL).
/// Writes start PROPOSED; only reviewStatus = HUMAN_APPROVED counts as promoted.
model KnowledgeEvidence {
  id              String                  @id @default(uuid())
  companyId       String
  company         Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  documentId      String
  document        KnowledgeDocument       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  extractionRunId String
  extractionRun   KnowledgeExtractionRun  @relation(fields: [extractionRunId], references: [id], onDelete: Cascade)
  entityId        String?
  entity          WorldEntity?            @relation(fields: [entityId], references: [id], onDelete: SetNull)
  relationId      String?
  relation        WorldRelation?          @relation(fields: [relationId], references: [id], onDelete: SetNull)
  excerpt         String
  excerptHash     String
  sourceLocation  String
  extractedAt     DateTime                @default(now())
  reviewStatus    String                  @default("PROPOSED")
  reviewedBy      String?
  reviewedAt      DateTime?
  createdBy       String
  createdAt       DateTime                @default(now())

  @@index([companyId, entityId])
  @@index([companyId, relationId])
  @@index([companyId, reviewStatus])
  @@index([extractionRunId])
}

model TwinScenario {
  id          String               @id @default(uuid())
  companyId   String
  company     Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  description String
  status      String               @default("DRAFT")
  baselineAt  DateTime?
  horizonDays Int                  @default(90)
  assumptions Json
  createdBy   String
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  changes     TwinScenarioChange[]
  result      TwinScenarioResult?

  @@index([companyId, status, createdAt])
}

model TwinScenarioChange {
  id              String       @id @default(uuid())
  scenarioId      String
  scenario        TwinScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  entityId        String?
  entity          WorldEntity? @relation(fields: [entityId], references: [id], onDelete: SetNull)
  entityType      String
  action          String
  patch           Json
  rationale       String
  sourceReference String
  createdBy       String
  createdAt       DateTime     @default(now())

  @@index([scenarioId, createdAt])
  @@index([entityId])
}

model TwinScenarioResult {
  id               String       @id @default(uuid())
  scenarioId       String       @unique
  scenario         TwinScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  dimensions       Json
  assumptions      Json
  uncertainty      Json
  confidence       Float
  missingData      String[]
  executionBlocked Boolean      @default(true)
  recordedBy       String
  recordedAt       DateTime     @default(now())

  @@index([recordedAt])
}

model HealthSnapshot {
  id                 String   @id @default(uuid())
  companyId          String
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  asOf               DateTime
  overallScore       Float?
  dimensions         Json
  missingData        String[]
  evidenceRefs       String[]
  calculationVersion String
  createdBy          String
  createdAt          DateTime @default(now())

  @@index([companyId, asOf])
}

model AttentionItem {
  id                     String    @id @default(uuid())
  companyId              String
  company                Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title                  String
  category               String
  valueScore             Float
  urgencyScore           Float
  impactScore            Float
  estimatedReviewMinutes Int
  priorityScore          Float
  status                 String    @default("OPEN")
  sourceRefs             String[]
  dueAt                  DateTime?
  createdBy              String
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([companyId, status, priorityScore])
}

model BoostaWorkspace {
  id                  String                         @id @default(uuid())
  companyId           String                         @unique
  name                String
  slug                String                         @unique
  status              String                         @default("ACTIVE")
  brainSummary        String
  createdBy           String
  createdAt           DateTime                       @default(now())
  updatedAt           DateTime                       @updatedAt
  brainVersions       BoostaBrainVersion[]
  authors             BoostaAuthor[]
  books               BoostaBook[]
  roles               BoostaAgentRole[]
  artifacts           BoostaArtifact[]
  reviews             BoostaReview[]
  approvals           BoostaWorkflowApproval[]
  submissions         BoostaDistributionSubmission[]
  subscribers         BoostaEmailSubscriber[]
  campaigns           BoostaEmailCampaign[]
  funnelEvents        BoostaFunnelEvent[]
  experiments         BoostaMarketingExperiment[]
  offers              BoostaOffer[]
  opportunities       BoostaB2BOpportunity[]
  weeklyReviews       BoostaWeeklyReview[]
  revenueAttributions BoostaRevenueAttribution[]

  @@index([companyId, status])
}

model BoostaBrainVersion {
  id          String          @id @default(uuid())
  workspaceId String
  workspace   BoostaWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  version     Int
  status      String          @default("DRAFT")
  content     Json
  source      String
  createdBy   String
  createdAt   DateTime        @default(now())

  @@unique([workspaceId, version])
  @@index([workspaceId, status])
}

model BoostaAuthor {
  id                 String          @id @default(uuid())
  workspaceId        String
  workspace          BoostaWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name               String
  biography          String
  website            String?
  verificationStatus String          @default("NEEDS_VERIFICATION")
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  books              BoostaBook[]

  @@unique([workspaceId, name])
}

model BoostaBook {
  id              String                         @id @default(uuid())
  workspaceId     String
  workspace       BoostaWorkspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  productId       String?
  authorId        String?
  author          BoostaAuthor?                  @relation(fields: [authorId], references: [id], onDelete: SetNull)
  title           String
  isbn            String?
  format          String?
  pageCount       Int?
  publicationDate DateTime?
  language        String                         @default("sv")
  categories      String[]
  keywords        String[]
  metadataStatus  String                         @default("NEEDS_VERIFICATION")
  priceMinor      BigInt?
  currency        String                         @default("SEK")
  createdAt       DateTime                       @default(now())
  updatedAt       DateTime                       @updatedAt
  submissions     BoostaDistributionSubmission[]

  @@unique([workspaceId, title])
  @@index([workspaceId, metadataStatus])
}

model BoostaAgentRole {
  id                    String          @id @default(uuid())
  workspaceId           String
  workspace             BoostaWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  key                   String
  name                  String
  role                  String
  allowedTools          String[]
  expectedInputs        String[]
  expectedOutputs       String[]
  qualityStandards      String[]
  humanApprovalRequired Boolean         @default(true)
  status                String          @default("ACTIVE")
  createdAt             DateTime        @default(now())

  @@unique([workspaceId, key])
}

model BoostaArtifact {
  id           String                   @id @default(uuid())
  workspaceId  String
  workspace    BoostaWorkspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  missionId    String?
  projectId    String?
  taskId       String?
  agentRunId   String?
  title        String
  artifactType String
  status       String                   @default("DRAFT")
  content      Json
  source       String
  createdBy    String
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  reviews      BoostaReview[]
  approvals    BoostaWorkflowApproval[]

  @@index([workspaceId, status, createdAt])
  @@index([missionId, projectId, taskId])
}

model BoostaReview {
  id          String          @id @default(uuid())
  workspaceId String
  workspace   BoostaWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  artifactId  String
  artifact    BoostaArtifact  @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  reviewer    String
  decision    String          @default("PENDING")
  notes       String?
  evidence    Json?
  createdAt   DateTime        @default(now())
  decidedAt   DateTime?

  @@index([workspaceId, decision])
}

model BoostaWorkflowApproval {
  id           String          @id @default(uuid())
  workspaceId  String
  workspace    BoostaWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  artifactId   String?
  artifact     BoostaArtifact? @relation(fields: [artifactId], references: [id], onDelete: SetNull)
  taskId       String?
  approvalType String
  decision     String          @default("PENDING")
  requestedBy  String
  decidedBy    String?
  comments     String?
  requestedAt  DateTime        @default(now())
  decidedAt    DateTime?

  @@index([workspaceId, decision])
}

model BoostaDistributionSubmission {
  id          String          @id @default(uuid())
  workspaceId String
  workspace   BoostaWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  bookId      String
  book        BoostaBook      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  retailer    String
  status      String          @default("NOT_STARTED")
  checklist   Json
  response    String?
  followUpAt  DateTime?
  submittedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([bookId, retailer])
  @@index([workspaceId, status])
}

model BoostaEmailSubscriber {
  id             String          @id @default(uuid())
  workspaceId    String
  workspace      BoostaWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email          String
  consentStatus  String          @default("PENDING")
  consentAt      DateTime?
  unsubscribedAt DateTime?
  source         String
  bookInterest   String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([workspaceId, email])
  @@index([workspaceId, consentStatus])
}

model BoostaEmailCampaign {
  id                     String          @id @default(uuid())
  workspaceId            String
  workspace              BoostaWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name                   String
  bookId                 String?
  status                 String          @default("DRAFT")
  consentRequired        Boolean         @default(true)
  sequence               Json
  attributedRevenueMinor BigInt          @default(0)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  @@index([workspaceId, status])
}

model BoostaFunnelEvent {
  id          String          @id @default(uuid())
  workspaceId String
  workspace   BoostaWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  eventType   String
  sessionId   String?
  email       String?
  bookId      String?
  campaign    String?
  source      String?
  valueMinor  BigInt?
  occurredAt  DateTime        @default(now())
  metadata    Json?

  @@index([workspaceId, eventType, occurredAt])
}

model BoostaMarketingExperiment {
  id               String          @id @default(uuid())
  workspaceId      String
  workspace        BoostaWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  bookId           String?
  name             String
  channel          String
  audience         String
  variants         Json
  dailyBudgetMinor BigInt          @default(0)
  totalBudgetMinor BigInt          @default(0)
  durationDays     Int             @default(0)
  killCriteria     String[]
  scaleCriteria    String[]
  status           String          @default("DRAFT")
  approvedBy       String?
  approvedAt       DateTime?
  spendMinor       BigInt          @default(0)
  results          Json?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([workspaceId, status])
}

model BoostaOffer {
  id               String          @id @default(uuid())
  workspaceId      String
  workspace        BoostaWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  bookId           String?
  name             String
  offerType        String
  priceMinor       BigInt?
  currency         String          @default("SEK")
  status           String          @default("DRAFT")
  approvalRequired Boolean         @default(true)
  approvedBy       String?
  approvedAt       DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([workspaceId, status])
}

model BoostaB2BOpportunity {
  id               String          @id @default(uuid())
  workspaceId      String
  workspace        BoostaWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  organization     String
  contact          String?
  stage            String          @default("LEAD")
  offer            String
  copies           Int?
  valueMinor       BigInt?
  expectedCloseAt  DateTime?
  proposal         Json?
  paymentStatus    String          @default("UNPAID")
  approvalRequired Boolean         @default(true)
  owner            String
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([workspaceId, stage])
}

model BoostaWeeklyReview {
  id               String          @id @default(uuid())
  workspaceId      String
  workspace        BoostaWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  weekStart        DateTime
  sales            Int             @default(0)
  revenueMinor     BigInt          @default(0)
  traffic          Int             @default(0)
  checkoutStarts   Int             @default(0)
  emailSignups     Int             @default(0)
  adSpendMinor     BigInt          @default(0)
  adResults        Json?
  retailerProgress Json?
  observations     String?
  reviewerOutput   Json?
  brainChanges     Json?
  status           String          @default("DRAFT")
  createdBy        String
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([workspaceId, weekStart])
  @@index([workspaceId, status])
}

model BoostaRevenueAttribution {
  id                 String          @id @default(uuid())
  workspaceId        String
  workspace          BoostaWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  economicEventId    String?
  productId          String?
  offerId            String?
  channel            String?
  campaign           String?
  landingPage        String?
  emailCampaignId    String?
  grossMinor         BigInt
  discountMinor      BigInt          @default(0)
  refundMinor        BigInt          @default(0)
  estimatedCostMinor BigInt          @default(0)
  netMinor           BigInt
  currency           String          @default("SEK")
  paymentStatus      String          @default("UNCONFIRMED")
  occurredAt         DateTime        @default(now())
  source             String
  createdAt          DateTime        @default(now())

  @@index([workspaceId, occurredAt])
  @@index([workspaceId, paymentStatus])
}
