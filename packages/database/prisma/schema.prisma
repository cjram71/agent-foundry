datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  OPERATOR
}

enum TaskStatus {
  draft
  awaiting_plan_approval
  approved
  queued
  planning
  coding
  testing
  reviewing
  awaiting_human_review
  pull_request_open
  preview_ready
  approved_for_merge
  rejected
  failed
  cancelled
  completed
}

enum TaskState {
  DRAFT
  QUEUED
  PLANNING
  RUNNING
  VALIDATING
  REVIEWING
  REPAIRING
  PR_CREATED
  PREVIEW_PENDING
  PREVIEW_READY
  AWAITING_APPROVAL
  CHANGES_REQUESTED
  HUMAN_INPUT_REQUIRED
  APPROVED
  REJECTED
  SECURITY_BLOCKED
  INFRASTRUCTURE_FAILED
  CODE_FAILED
  FAILED
  CANCELLED
  COMPLETED
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  role          Role      @default(OPERATOR)
  createdAt     DateTime  @default(now())
  lastLoginAt   DateTime?
  sessions      Session[]
}

model Session {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  lastSeenAt  DateTime  @default(now())
  ip          String?
  userAgent   String?
  revokedAt   DateTime?

  @@index([userId])
  @@index([expiresAt])
}

model Project {
  id                 String    @id @default(uuid())
  name               String
  githubOwner        String
  githubRepo         String
  defaultBranch      String    @default("main")
  projectType        String    @default("web_app")
  productionUrl      String?
  vercelProjectRef   String?
  vercelTeamRef      String?
  authorisedStatus   Boolean   @default(false)
  spendingLimit      Float     @default(50.00)
  createdAt          DateTime  @default(now())
  tasks              Task[]
}

model Task {
  id                 String       @id @default(uuid())
  projectId          String
  project            Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title              String
  completeInstruction String
  status             TaskStatus   @default(draft)
  state              TaskState    @default(DRAFT)
  riskLevel          String       @default("medium")
  assignedAgent      String?
  branchName         String?
  pullRequestUrl     String?
  previewUrl         String?
  tokenUsage         Int          @default(0)
  estimatedCost      Float        @default(0.0)
  currentAttemptId   String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  startedAt          DateTime?
  completedAt        DateTime?
  agentRuns          AgentRun[]
  approvals          Approval[]
  attempts           TaskAttempt[]
  stateTransitions   TaskStateTransition[]
}

model TaskAttempt {
  id             String    @id @default(uuid())
  taskId         String
  task           Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  attemptNumber  Int
  status         String    @default("running")
  correlationId  String
  workspacePath  String?
  branchName     String?
  commitSha      String?
  outcomeSummary String?
  startedAt      DateTime  @default(now())
  endedAt        DateTime?
  transitions    TaskStateTransition[]

  @@unique([taskId, attemptNumber])
  @@index([taskId])
}

model TaskStateTransition {
  id            String       @id @default(uuid())
  taskId        String
  task          Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  attemptId     String?
  attempt       TaskAttempt? @relation(fields: [attemptId], references: [id], onDelete: SetNull)
  fromState     TaskState
  toState       TaskState
  actor         String
  actorType     String       @default("system")
  reason        String?
  correlationId String?
  metadata      Json?
  createdAt     DateTime     @default(now())

  @@index([taskId])
  @@index([correlationId])
  @@index([createdAt])
}

model AgentRun {
  id            String    @id @default(uuid())
  taskId        String
  task          Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  provider      String
  model         String
  role          String
  promptHash    String
  status        String
  tokenUsage    Int       @default(0)
  outputSummary String?
  errorInfo     String?
  createdAt     DateTime  @default(now())
}

model Approval {
  id            String    @id @default(uuid())
  taskId        String
  task          Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  approvalType  String    // 'plan', 'merge', 'infrastructure'
  requestedAt   DateTime  @default(now())
  approvedBy    String?
  approvedAt    DateTime?
  decision      String    @default("pending") // 'pending', 'approved', 'rejected'
  comments      String?
}

model AuditEvent {
  id        String   @id @default(uuid())
  actor     String
  action    String
  target    String
  result    String
  metadata  Json?
  timestamp DateTime @default(now())
}
