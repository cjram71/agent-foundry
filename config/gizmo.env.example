# Gizmo OS v2 installer/runtime configuration
# Copy to /etc/gizmo/gizmo.env (0600). Never commit real secrets.

GIZMO_ROOT=/srv/gizmo
GIZMO_REPO=/opt/gizmo-os
GIZMO_CHECKPOINT_DIR=/srv/gizmo/checkpoints
GIZMO_CATALOG_DIR=/srv/gizmo/catalogs
GIZMO_KNOWLEDGE_DIR=/srv/gizmo/knowledge-vault
GIZMO_BACKUP_DIR=/srv/gizmo/backups

# Existing Agent Foundry database/Redis remain authoritative.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_ADMIN_USER=foundry_admin
POSTGRES_ADMIN_PASSWORD=REPLACE_ME
REDIS_PASSWORD=REPLACE_ME
PGVECTOR_IMAGE=REPLACE_WITH_PINNED_POSTGRES16_PGVECTOR_IMAGE

# n8n - separate database/user.
N8N_DB_NAME=n8n
N8N_DB_USER=n8n_app
N8N_DB_PASSWORD=REPLACE_ME
N8N_ENCRYPTION_KEY=REPLACE_WITH_32_PLUS_RANDOM_CHARS
N8N_IMAGE=REPLACE_WITH_PINNED_N8N_IMAGE
N8N_BIND=127.0.0.1:5678

# LiteLLM - private only.
LITELLM_MASTER_KEY=REPLACE_ME
LITELLM_IMAGE=REPLACE_WITH_PINNED_LITELLM_IMAGE
LITELLM_BIND=127.0.0.1:4000
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_URL=http://127.0.0.1:11434

# Observability images MUST be pinned before production install.
GRAFANA_IMAGE=REPLACE_WITH_PINNED_GRAFANA_IMAGE
PROMETHEUS_IMAGE=REPLACE_WITH_PINNED_PROMETHEUS_IMAGE
LOKI_IMAGE=REPLACE_WITH_PINNED_LOKI_IMAGE
TEMPO_IMAGE=REPLACE_WITH_PINNED_TEMPO_IMAGE
ALLOY_IMAGE=REPLACE_WITH_PINNED_ALLOY_IMAGE
NODE_EXPORTER_IMAGE=REPLACE_WITH_PINNED_NODE_EXPORTER_IMAGE
CADVISOR_IMAGE=REPLACE_WITH_PINNED_CADVISOR_IMAGE
GRAFANA_ADMIN_PASSWORD=REPLACE_ME

# Approved external Workflow Template Catalog.
GIZMO_N8N_CATALOG_REPO=https://github.com/cjram71/awesome-n8n-templates.git
GIZMO_N8N_CATALOG_COMMIT=2546df5f3da5ad12c9bbda4c51da39c3366c0d3e

# Restic optional until repository is configured.
RESTIC_REPOSITORY=
RESTIC_PASSWORD=

# Installer safety. Keep false until the relevant checkpoint has been reviewed.
GIZMO_ALLOW_DATABASE_CHANGES=false
GIZMO_ALLOW_PUBLIC_INGRESS=false
GIZMO_ALLOW_PRODUCTION_CUTOVER=false
# Comma-separated phase IDs explicitly approved by the human owner.
GIZMO_HUMAN_APPROVED_PHASES=
