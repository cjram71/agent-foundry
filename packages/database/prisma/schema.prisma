  confidence       Float                @default(0)
  classification   String               @default("INTERNAL")
  validFrom        DateTime?
  validUntil       DateTime?
  createdBy        String
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  outgoing         WorldRelation[]      @relation("WorldRelationFrom")
  incoming         WorldRelation[]      @relation("WorldRelationTo")
