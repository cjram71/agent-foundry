# Application
PORT=3000
NODE_ENV=production
APP_URL=http://127.0.0.1:3000
JWT_SECRET=replace_with_at_least_48_random_bytes
# Single signing secret model (P3): ADMIN_JWT_SECRET was never read by any code
# and has been removed. If a separate admin-scoped secret is ever needed, it
# must be wired into the role system first (Phase P4 decision).

# PostgreSQL and Redis
POSTGRES_USER=foundry_admin
POSTGRES_DB=agent_foundry
POSTGRES_PASSWORD=replace_with_a_unique_random_password
DATABASE_URL=postgresql://foundry_admin:replace_with_a_unique_random_password@127.0.0.1:5432/agent_foundry
REDIS_PASSWORD=replace_with_a_different_random_password
REDIS_URL=redis://:replace_with_a_different_random_password@127.0.0.1:6379

# GitHub CLI/App configuration
GITHUB_CLI_ENABLED=true
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_PRIVATE_KEY_PATH=
GIT_AUTHOR_NAME=Agent Foundry
GIT_AUTHOR_EMAIL=agent-foundry@users.noreply.github.com
FOUNDRY_REPO_ROOT=/srv/agent-foundry/workspaces

# Agent catalog
AGENT_CATALOG_PATH=/srv/agent-foundry/catalogs/500-AI-Agents-Projects
# Pinned, reviewed commit of the catalog clone above. REQUIRED in production
# (P9): the orchestrator verifies the checkout against this sha on every
# planning job and fails closed on mismatch. Review upstream changes, then
# advance the pin — docs/ROLE-CATALOG.md. Empty = unpinned development mode
# (clones work, but every plan records catalogPinned:false).
AGENT_CATALOG_COMMIT=

# Cloud AI provider: add later; never commit the value
GEMINI_API_KEY=
BOOSTA_WORKSPACE_ROOT=/srv/boosta
BOOSTA_EDITORIAL_MODEL=gemini-3-flash-preview

# Optional private Ollama fallback: install model separately
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:3b

# Private n8n API adapter. Create a scoped API key in n8n; never commit it.
N8N_URL=http://127.0.0.1:5678
N8N_API_KEY=

# Validation sandbox
SANDBOX_IMAGE=node:20-bookworm-slim
SANDBOX_MEMORY=2g
SANDBOX_CPUS=1.5
# Repair loop (P11; docs/REPAIR.md): how many times the coder may revise
# after a validation failure or review rejection within one execution.
# 0 disables repair (first failure is terminal), 3 is the hard ceiling.
MAX_REPAIR_ATTEMPTS=2

# Operations (P14; docs/OPERATIONS.md)
# Minutes without state-machine progress before an active execution is
# declared wedged and recovered to INFRASTRUCTURE_FAILED (5-360).
WEDGE_TIMEOUT_MINUTES=45
# Provider token price used for cost accounting + the project spending
# brake. Unset/0 = $0 accounting (brake permissive — the health endpoint
# reports costRateConfigured:false). Set your contract rate.
TOKEN_COST_PER_MILLION_USD=
N8N_CAMPAIGN_WEBHOOK_URL=http://127.0.0.1:5678/webhook/boosta-campaign-verify
