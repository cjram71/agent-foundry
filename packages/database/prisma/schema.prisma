datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  OPERATOR
}

enum TaskStatus {
  draft
  awaiting_plan_approval
  approved
  queued
  planning
  coding
  testing
  reviewing
  awaiting_human_review
  pull_request_open
  preview_ready
  approved_for_merge
  rejected
  failed
  cancelled
  completed
}

enum TaskState {
  DRAFT
  QUEUED
  PLANNING
  RUNNING
  VALIDATING
  REVIEWING
  REPAIRING
  PR_CREATED
  PREVIEW_PENDING
  PREVIEW_READY
  AWAITING_APPROVAL
  CHANGES_REQUESTED
  HUMAN_INPUT_REQUIRED
  APPROVED
  REJECTED
  SECURITY_BLOCKED
  INFRASTRUCTURE_FAILED
  CODE_FAILED
  FAILED
  CANCELLED
  COMPLETED
}

enum AgentLifecycleStatus {
  EXPERIMENTAL
  STAGING
  ACTIVE
  RETIRED
}

enum MemoryKind {
  WORKING
  CONVERSATION
  SEMANTIC
  STRUCTURED
  ARTIFACT
  OPERATIONAL
}

enum MemoryStatus {
  CANDIDATE
  APPROVED
  REJECTED
  EXPIRED
}

enum ProjectRunStatus {
  RUNNING
  READY_FOR_REVIEW
  COMPLETED
  PAUSED
  FAILED
  CANCELLED
}

model AgentDefinition {
  id        String         @id
  name      String
  mission   String
  owner     String         @default("gizmo")
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  versions  AgentVersion[]
}

model AgentVersion {
  id            String               @id @default(uuid())
  agentId       String
  agent         AgentDefinition      @relation(fields: [agentId], references: [id], onDelete: Restrict)
  version       String
  status        AgentLifecycleStatus @default(EXPERIMENTAL)
  manifest      Json
  checksum      String
  createdBy     String
  createdAt     DateTime             @default(now())
  activatedAt   DateTime?
  retiredAt     DateTime?
  projectAgents ProjectAgent[]

  @@unique([agentId, version])
  @@index([agentId, status])
  @@index([status])
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  role         Role      @default(OPERATOR)
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?
  sessions     Session[]
}

model Session {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  lastSeenAt DateTime  @default(now())
  ip         String?
  userAgent  String?
  revokedAt  DateTime?

  @@index([userId])
  @@index([expiresAt])
}

model Project {
  id               String          @id @default(uuid())
  companyId        String?
  company          Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  name             String
  githubOwner      String
  githubRepo       String
  defaultBranch    String          @default("main")
  projectType      String          @default("web_app")
  productionUrl    String?
  vercelProjectRef String?
  vercelTeamRef    String?
  authorisedStatus Boolean         @default(false)
  spendingLimit    Float           @default(50.00)
  createdAt        DateTime        @default(now())
  tasks            Task[]
  policies         ProjectPolicy[]
  memories         MemoryRecord[]
  revenueStreams   RevenueStream[]
  economicEvents   EconomicEvent[]
  runs             ProjectRun[]
  missions         Mission[]
  projectAgents    ProjectAgent[]

  @@index([companyId, createdAt])
}

model ProjectRun {
  id                  String           @id @default(uuid())
  projectId           String
  project             Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  policyVersion       Int
  status              ProjectRunStatus @default(RUNNING)
  objective           String
  report              Json?
  recommendations     Json?
  tasksTotal          Int              @default(0)
  tasksCompleted      Int              @default(0)
  tasksFailed         Int              @default(0)
  estimatedCost       Float            @default(0)
  startedBy           String
  startedAt           DateTime         @default(now())
  finishedAt          DateTime?
  executionApprovedAt DateTime?
  approvedBy          String?
  updatedAt           DateTime         @updatedAt
  tasks               Task[]

  @@index([projectId, status])
  @@index([startedAt])
  @@index([status, executionApprovedAt])
}

model ProjectPolicy {
  id                      String   @id @default(uuid())
  projectId               String
  project                 Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version                 Int
  active                  Boolean  @default(false)
  maxTaskRisk             String   @default("high") // 'low', 'medium', 'high' — prohibited is never a settable ceiling
  requirePlanApproval     Boolean  @default(true)
  requireMergeApproval    Boolean  @default(true)
  autonomousMode          Boolean  @default(false)
  autoApproveMaxRisk      String   @default("medium")
  maxParallelTasks        Int      @default(2)
  maxRepairAttempts       Int      @default(2)
  maxTasksPerRun          Int      @default(20)
  maxTaskCost             Float    @default(2.0)
  maxProjectRunCost       Float    @default(20.0)
  createDraftPullRequests Boolean  @default(true)
  createdBy               String
  createdAt               DateTime @default(now())

  @@unique([projectId, version])
  @@index([projectId, active])
}

model Mission {
  id                   String            @id @default(uuid())
  companyId            String?
  company              Company?          @relation(fields: [companyId], references: [id], onDelete: SetNull)
  version              Int               @default(1)
  goal                 String
  contextSummary       String?
  constraints          String[]
  deliverables         String[]
  definitionOfDone     String[]
  failureConditions    String[]
  riskLevel            String
  budgetUsd            Float
  tokenBudget          Int
  maxParallelTasks     Int
  allowedToolClasses   String[]
  approvalRules        String[]
  deadline             DateTime?
  projectId            String?
  project              Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  businessId           String?
  provenance           String
  status               String            @default("draft")
  createdBy            String
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  charterId            String?
  charterVersion       Int?
  charter              FoundryCharter?   @relation(fields: [charterId], references: [id], onDelete: Restrict)
  missionTemplateId    String?
  missionTemplate      MissionTemplate?  @relation(fields: [missionTemplateId], references: [id], onDelete: SetNull)
  revenueStreamId      String?
  revenueStream        RevenueStream?    @relation(fields: [revenueStreamId], references: [id], onDelete: SetNull)
  pricingModel         String?
  revenueTargetMinor   BigInt?
  economicStatus       String            @default("untracked")
  measurementStartedAt DateTime?
  measurementEndsAt    DateTime?
  economicEvents       EconomicEvent[]
  tasks                MissionTask[]
  approvals            MissionApproval[]
  events               MissionEvent[]

  @@index([projectId, status])
  @@index([companyId, status])
  @@index([businessId, status])
  @@index([createdAt])
  @@index([charterId, charterVersion])
  @@index([missionTemplateId])
  @@index([revenueStreamId, economicStatus])
}

model Company {
  id                 String                @id
  legalName          String
  displayName        String
  organizationNumber String                @unique
  jurisdiction       String                @default("SE")
  legalForm          String
  status             String                @default("ACTIVE")
  primaryLanguage    String                @default("sv")
  reportingCurrency  String                @default("SEK")
  operatingModel     String                @default("OWNER_OPERATED")
  employeeCount      Int?
  shareCapitalMinor  BigInt?
  registeredAddress  Json?
  postalAddress      Json?
  registeredSeat     Json?
  registrations      Json?
  managingDirector   String?
  description        String
  sourceStatus       String                @default("OWNER_CONFIRMED")
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  activities         CompanyActivity[]
  sources            CompanySource[]
  facts              CompanyFact[]
  constitutions      CompanyConstitution[]
  projects           Project[]
  missions           Mission[]

  @@index([status])
}

model CompanyActivity {
  id          String   @id @default(uuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category    String
  name        String
  description String?
  registered  Boolean  @default(true)
  status      String   @default("CAPABILITY")
  createdAt   DateTime @default(now())

  @@unique([companyId, category, name])
  @@index([companyId, category])
}

model CompanySource {
  id                 String    @id @default(uuid())
  companyId          String
  company            Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sourceType         String
  sourceUrl          String?
  sourceAuthority    String
  verificationStatus String
  effectiveAt        DateTime?
  retrievedAt        DateTime  @default(now())
  contentHash        String?
  notes              String?

  @@index([companyId, verificationStatus])
}

model CompanyFact {
  id                 String       @id @default(uuid())
  companyId          String
  company            Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  factType           String
  value              Json
  confidence         Float?
  verificationStatus String       @default("PROPOSED")
  validFrom          DateTime?
  validUntil         DateTime?
  supersededById     String?      @unique
  supersededBy       CompanyFact? @relation("CompanyFactSupersession", fields: [supersededById], references: [id], onDelete: Restrict)
  supersedes         CompanyFact? @relation("CompanyFactSupersession")
  createdBy          String
  createdAt          DateTime     @default(now())

  @@index([companyId, factType, verificationStatus])
}

model CompanyConstitution {
  id                   String               @id @default(uuid())
  companyId            String
  company              Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  version              Int
  status               String               @default("DRAFT")
  mission              String
  values               String[]
  strategicObjectives  String[]
  humanOnlyDecisions   String[]
  prohibitedActivities String[]
  autonomousLimits     Json
  dataAuthority        Json
  securityPrinciples   String[]
  escalationRules      String[]
  emergencyProcedures  String[]
  approvedBy           String?
  approvedAt           DateTime?
  supersedesId         String?              @unique
  supersedes           CompanyConstitution? @relation("CompanyConstitutionSupersession", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy         CompanyConstitution? @relation("CompanyConstitutionSupersession")
  createdBy            String
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@unique([companyId, version])
  @@index([companyId, status])
}

model MissionTask {
  id        String   @id @default(uuid())
  missionId String
  mission   Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  taskId    String   @unique
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Restrict)
  sequence  Int
  createdAt DateTime @default(now())

  @@unique([missionId, sequence])
  @@index([missionId])
}

model MissionApproval {
  id           String    @id @default(uuid())
  missionId    String
  mission      Mission   @relation(fields: [missionId], references: [id], onDelete: Cascade)
  approvalType String
  decision     String    @default("pending")
  requestedAt  DateTime  @default(now())
  decidedAt    DateTime?
  decidedBy    String?
  comments     String?

  @@index([missionId, decision])
}

model MissionEvent {
  id            String   @id @default(uuid())
  missionId     String
  mission       Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  type          String
  actor         String
  actorType     String   @default("system")
  correlationId String?
  payload       Json?
  createdAt     DateTime @default(now())

  @@index([missionId, createdAt])
  @@index([correlationId])
}

model Task {
  id                  String                @id @default(uuid())
  projectId           String
  project             Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title               String
  completeInstruction String
  status              TaskStatus            @default(draft)
  state               TaskState             @default(DRAFT)
  riskLevel           String                @default("medium")
  assignedAgent       String?
  branchName          String?
  pullRequestUrl      String?
  previewUrl          String?
  tokenUsage          Int                   @default(0)
  estimatedCost       Float                 @default(0.0)
  currentAttemptId    String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  startedAt           DateTime?
  completedAt         DateTime?
  agentRuns           AgentRun[]
  approvals           Approval[]
  attempts            TaskAttempt[]
  stateTransitions    TaskStateTransition[]
  events              TaskEvent[]
  memories            MemoryRecord[]
  missionLink         MissionTask?
  projectRunId        String?
  projectRun          ProjectRun?           @relation(fields: [projectRunId], references: [id], onDelete: SetNull)

  @@index([projectRunId, state])
}

model TaskAttempt {
  id             String                @id @default(uuid())
  taskId         String
  task           Task                  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  attemptNumber  Int
  status         String                @default("running")
  correlationId  String
  workspacePath  String?
  branchName     String?
  commitSha      String?
  outcomeSummary String?
  startedAt      DateTime              @default(now())
  endedAt        DateTime?
  transitions    TaskStateTransition[]
  events         TaskEvent[]

  @@unique([taskId, attemptNumber])
  @@index([taskId])
}

model TaskStateTransition {
  id            String       @id @default(uuid())
  taskId        String
  task          Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  attemptId     String?
  attempt       TaskAttempt? @relation(fields: [attemptId], references: [id], onDelete: SetNull)
  fromState     TaskState
  toState       TaskState
  actor         String
  actorType     String       @default("system")
  reason        String?
  correlationId String?
  metadata      Json?
  createdAt     DateTime     @default(now())

  @@index([taskId])
  @@index([correlationId])
  @@index([createdAt])
}

enum TaskEventType {
  task_created
  task_queued
  planning_started
  plan_generated
  plan_approval_requested
  plan_approved
  plan_rejected
  execution_started
  code_generated
  validation_started
  validation_passed
  validation_failed
  review_started
  review_passed
  review_failed
  draft_pr_opened
  preview_ready
  final_approval_requested
  final_approved
  final_rejected
  task_completed
  task_failed
  task_cancelled
  task_state_changed
}

model TaskEvent {
  id            String        @id @default(uuid())
  taskId        String
  task          Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  attemptId     String?
  attempt       TaskAttempt?  @relation(fields: [attemptId], references: [id], onDelete: SetNull)
  type          TaskEventType
  actor         String
  actorType     String        @default("system")
  correlationId String?
  payload       Json?
  createdAt     DateTime      @default(now())

  @@index([taskId])
  @@index([type])
  @@index([correlationId])
  @@index([createdAt])
}

model AgentRun {
  id            String   @id @default(uuid())
  taskId        String
  task          Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  provider      String
  model         String
  role          String
  promptHash    String
  status        String
  tokenUsage    Int      @default(0)
  outputSummary String?
  errorInfo     String?
  createdAt     DateTime @default(now())
}

model Approval {
  id           String    @id @default(uuid())
  taskId       String
  task         Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  approvalType String // 'plan', 'merge', 'infrastructure'
  requestedAt  DateTime  @default(now())
  approvedBy   String?
  approvedAt   DateTime?
  decision     String    @default("pending") // 'pending', 'approved', 'rejected'
  comments     String?
}

model MemoryRecord {
  id               String                       @id @default(uuid())
  kind             MemoryKind
  status           MemoryStatus                 @default(CANDIDATE)
  agentId          String
  taskId           String?
  task             Task?                        @relation(fields: [taskId], references: [id], onDelete: SetNull)
  projectId        String?
  project          Project?                     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  businessId       String?
  sourceReference  String?
  scopeType        String
  scopeId          String
  summary          String
  content          Json?
  contentHash      String
  provenance       String
  source           String                       @default("legacy")
  confidence       Float?
  trustLevel       String                       @default("untrusted")
  sensitivity      String                       @default("INTERNAL")
  retentionUntil   DateTime
  observedAt       DateTime?
  reviewAt         DateTime?
  expiresAt        DateTime?
  embeddingModel   String?
  embeddingVersion String?
  embedding        Unsupported("vector(1536)")?
  searchVector     Unsupported("tsvector")?
  approvedBy       String?
  artifact         ArtifactRecord?
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt

  @@unique([contentHash, scopeType, scopeId])
  @@index([scopeType, scopeId, status])
  @@index([agentId, kind])
  @@index([retentionUntil])
  @@index([projectId, trustLevel])
  @@index([businessId, trustLevel])
}

model ArtifactRecord {
  id             String       @id @default(uuid())
  memoryRecordId String       @unique
  memoryRecord   MemoryRecord @relation(fields: [memoryRecordId], references: [id], onDelete: Cascade)
  relativePath   String       @unique
  mimeType       String?
  sizeBytes      Int
  checksum       String
  createdAt      DateTime     @default(now())
}

model AuditEvent {
  id        String   @id @default(uuid())
  actor     String
  action    String
  target    String
  result    String
  metadata  Json?
  timestamp DateTime @default(now())
}

model FoundryCharter {
  id                           String          @id @default(uuid())
  version                      Int             @unique
  status                       String          @default("draft")
  name                         String
  goal                         String
  constraints                  String[]
  allowedToolClasses           String[]
  requiredApprovalRules        String[]
  maxMissionBudgetMinor        BigInt
  monthlyOperatingBudgetMinor  BigInt
  monthlyExperimentBudgetMinor BigInt
  currency                     String
  defaultTokenBudget           Int
  hardTokenCeiling             Int
  maxParallelMissions          Int
  reviewIntervalDays           Int
  approvedBy                   String?
  approvedAt                   DateTime?
  supersedesId                 String?         @unique
  supersedes                   FoundryCharter? @relation("CharterSupersession", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy                 FoundryCharter? @relation("CharterSupersession")
  createdBy                    String
  createdAt                    DateTime        @default(now())
  updatedAt                    DateTime        @updatedAt
  missions                     Mission[]

  @@index([status])
}

model MissionTemplate {
  id                        String    @id @default(uuid())
  key                       String
  version                   Int
  name                      String
  description               String
  missionType               String
  status                    String    @default("draft")
  defaultRiskLevel          String
  defaultBudgetMinor        BigInt
  defaultTokenBudget        Int
  defaultMaxParallelTasks   Int
  allowedToolClasses        String[]
  requiredApprovalRules     String[]
  definitionOfDoneTemplate  String[]
  failureConditionsTemplate String[]
  measurementWindowDays     Int
  leadingIndicators         String[]
  laggingIndicators         String[]
  killCriteria              String[]
  pricingModels             String[]
  createdBy                 String
  certifiedBy               String?
  certifiedAt               DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  missions                  Mission[]

  @@unique([key, version])
  @@index([status, missionType])
}

model RevenueStream {
  id             String          @id @default(uuid())
  projectId      String?
  project        Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  businessId     String?
  name           String
  key            String          @unique
  missionType    String
  status         String          @default("proposed")
  pricingModel   String
  owner          String
  currency       String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  missions       Mission[]
  economicEvents EconomicEvent[]

  @@index([projectId, status])
  @@index([businessId, status])
}

model EconomicEvent {
  id                String         @id @default(uuid())
  missionId         String?
  mission           Mission?       @relation(fields: [missionId], references: [id], onDelete: SetNull)
  projectId         String?
  project           Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  revenueStreamId   String?
  revenueStream     RevenueStream? @relation(fields: [revenueStreamId], references: [id], onDelete: SetNull)
  type              String
  amountMinor       BigInt
  currency          String
  category          String
  source            String
  externalReference String?
  attributionMethod String
  evidence          Json?
  idempotencyKey    String         @unique
  occurredAt        DateTime
  recordedBy        String
  createdAt         DateTime       @default(now())

  @@index([missionId, occurredAt])
  @@index([projectId, occurredAt])
  @@index([revenueStreamId, occurredAt])
  @@index([type, occurredAt])
}

model ProjectAgent {
  id                   String           @id @default(uuid())
  projectId            String
  project              Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agentVersionId       String
  agentVersion         AgentVersion     @relation(fields: [agentVersionId], references: [id], onDelete: Restrict)
  status               String           @default("supervised")
  supervisedRuns       Int              @default(0)
  acceptedRuns         Int              @default(0)
  requiredTestsPassed  Boolean          @default(false)
  securityReviewPassed Boolean          @default(false)
  charterVersion       Int?
  scheduleEnabled      Boolean          @default(false)
  scheduleExpression   String?
  certifiedBy          String?
  certifiedAt          DateTime?
  pausedAt             DateTime?
  retiredAt            DateTime?
  n8nWorkflowId        String?          @unique
  createdBy            String
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  reports              AgentRunReport[]

  @@unique([projectId, agentVersionId])
  @@index([projectId, status])
  @@index([agentVersionId, status])
}

model AgentRunReport {
  id                 String       @id @default(uuid())
  projectAgentId     String
  projectAgent       ProjectAgent @relation(fields: [projectAgentId], references: [id], onDelete: Cascade)
  taskId             String?
  completed          String[]
  waitingForApproval String[]
  uncertain          String[]
  evidence           String[]
  memoryCandidates   Json?
  accepted           Boolean?
  reviewNotes        String?
  reviewedBy         String?
  reviewedAt         DateTime?
  startedAt          DateTime
  completedAt        DateTime
  createdAt          DateTime     @default(now())

  @@index([projectAgentId, createdAt])
  @@index([taskId])
}
